# 本地预览（wrangler dev）专用的环境变量，不要提交到 git（已在 .gitignore）
NEXTJS_ENV=development

# 本地预览走直连数据库（Cloudflare 运行时请设为 1 并使用 Hyperdrive 绑定）
CLOUDFLARE_HYPERDRIVE=0

# 以下密钥/变量在 Cloudflare 后台按需配置，本地预览时按需取消注释：
# DATABASE_URL=postgresql://...
# AUTH_SECRET=...
# AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# CHEVERETO_API_URL=https://www.picgo.net
# CHEVERETO_API_KEY=...
# CHEVERETO_ALBUM_ID=...
# CHEVERETO_PENDING_ALBUM_ID=...
# CHEVERETO_AVATAR_ALBUM_ID=...
